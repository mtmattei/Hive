<UserControl
    x:Class="Hive.Controls.ScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hive.Controls">

    <!-- Schedule View: multi-day columns with stacked event cards -->
    <Border Style="{StaticResource GridContainerStyle}" Padding="0">
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ColumnsGrid" Padding="8">
                <!-- Columns will be dynamically generated in code-behind based on ScheduleViewDays -->
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
