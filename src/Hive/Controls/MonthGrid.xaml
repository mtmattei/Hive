<UserControl
    x:Class="Hive.Controls.MonthGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Month View: standard calendar grid -->
    <Border Style="{StaticResource GridContainerStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Day-of-week headers -->
                <RowDefinition Height="*" />      <!-- 6 week rows -->
            </Grid.RowDefinitions>

            <!-- Day-of-week headers (SeaDeep) -->
            <Border Grid.Row="0" Style="{StaticResource MonthHeaderStyle}">
                <Grid x:Name="DowHeaderGrid">
                    <!-- Populated dynamically -->
                </Grid>
            </Border>

            <!-- Grid of day cells -->
            <Grid Grid.Row="1" x:Name="DayCellsGrid" Padding="4">
                <!-- 7 columns × 6 rows, populated dynamically -->
            </Grid>
        </Grid>
    </Border>
</UserControl>
