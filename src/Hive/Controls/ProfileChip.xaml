<UserControl
    x:Class="Hive.Controls.ProfileChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Hive.Converters">

    <UserControl.Resources>
        <converters:HexColorToBrushConverter x:Key="HexToBrush" />
        <converters:HexColorToBrushConverter x:Key="HexToBrushFaded" Opacity="0.15" />
    </UserControl.Resources>

    <Button Click="OnClick" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0">
        <Border CornerRadius="20" Padding="10,5"
                Background="{Binding Color, Converter={StaticResource HexToBrushFaded}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="10" Height="10" CornerRadius="5"
                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                <TextBlock Text="{Binding Name}"
                           FontFamily="{StaticResource BodyFontSemiBold}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>
    </Button>
</UserControl>
