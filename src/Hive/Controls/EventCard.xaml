<UserControl
    x:Class="Hive.Controls.EventCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Hive.Converters">

    <UserControl.Resources>
        <converters:HexColorToBrushConverter x:Key="HexToBrush" />
        <converters:HexColorToTintConverter x:Key="HexToTint" />
        <converters:TimeFormatConverter x:Key="TimeFormat" />
    </UserControl.Resources>

    <!-- Event card with colored left border + tinted background -->
    <Border CornerRadius="10"
            BorderThickness="4,0,0,0"
            BorderBrush="{x:Bind ProfileColor, Mode=OneWay, Converter={StaticResource HexToBrush}}"
            Background="{x:Bind ProfileColor, Mode=OneWay, Converter={StaticResource HexToTint}}"
            Padding="12,10"
            Margin="0,0,0,6">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                           Style="{StaticResource BodySemiBoldStyle}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
                <TextBlock Text="{x:Bind TimeDisplay, Mode=OneWay}"
                           Style="{StaticResource EventTimeStyle}"
                           Visibility="{x:Bind IsTimedEvent, Mode=OneWay}" />
            </StackPanel>

            <!-- Profile initial circle -->
            <Border Grid.Column="1"
                    Width="24" Height="24" CornerRadius="12"
                    Background="{x:Bind ProfileColor, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                    VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ProfileInitial, Mode=OneWay}"
                           Foreground="White" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
