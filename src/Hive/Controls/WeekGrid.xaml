<UserControl
    x:Class="Hive.Controls.WeekGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Week View: 7-column time grid -->
    <Border Style="{StaticResource GridContainerStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Day headers -->
                <RowDefinition Height="*" />      <!-- Time grid -->
            </Grid.RowDefinitions>

            <!-- Day headers (SeaDeep background) -->
            <Border Grid.Row="0" Style="{StaticResource MonthHeaderStyle}">
                <Grid x:Name="DayHeadersGrid">
                    <!-- Populated dynamically -->
                </Grid>
            </Border>

            <!-- Scrollable time grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="TimeGrid" Height="1440">
                    <!-- 24 hours × 60px per hour = 1440px -->
                    <!-- Time labels + event blocks positioned dynamically -->
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
