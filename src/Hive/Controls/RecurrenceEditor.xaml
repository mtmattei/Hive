<UserControl
    x:Class="Hive.Controls.RecurrenceEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <!-- Enable recurrence toggle -->
        <ToggleSwitch x:Name="EnableRepeat" Header="Repeat" Toggled="OnRepeatToggled" />

        <!-- Recurrence options (shown when repeat is on) -->
        <StackPanel x:Name="RecurrenceOptions" Visibility="Collapsed" Spacing="12"
                    Padding="0,0,0,0">

            <!-- Frequency -->
            <ComboBox x:Name="FrequencyCombo" Header="Frequency" SelectedIndex="0"
                      HorizontalAlignment="Stretch" SelectionChanged="OnFrequencyChanged">
                <ComboBoxItem Content="Daily" Tag="Daily" />
                <ComboBoxItem Content="Weekly" Tag="Weekly" />
                <ComboBoxItem Content="Monthly" Tag="Monthly" />
                <ComboBoxItem Content="Yearly" Tag="Yearly" />
            </ComboBox>

            <!-- Interval -->
            <NumberBox x:Name="IntervalBox" Header="Every" Value="1"
                       Minimum="1" Maximum="30"
                       SpinButtonPlacementMode="Compact" />

            <!-- Days of week (shown for Weekly) -->
            <StackPanel x:Name="DaysOfWeekPanel" Visibility="Collapsed" Spacing="4">
                <TextBlock Text="On days" Style="{StaticResource SmallLabelStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="DaySun" Content="S" Width="36" Height="36" CornerRadius="18" />
                    <ToggleButton x:Name="DayMon" Content="M" Width="36" Height="36" CornerRadius="18" />
                    <ToggleButton x:Name="DayTue" Content="T" Width="36" Height="36" CornerRadius="18" />
                    <ToggleButton x:Name="DayWed" Content="W" Width="36" Height="36" CornerRadius="18" />
                    <ToggleButton x:Name="DayThu" Content="T" Width="36" Height="36" CornerRadius="18" />
                    <ToggleButton x:Name="DayFri" Content="F" Width="36" Height="36" CornerRadius="18" />
                    <ToggleButton x:Name="DaySat" Content="S" Width="36" Height="36" CornerRadius="18" />
                </StackPanel>
            </StackPanel>

            <!-- End date -->
            <CalendarDatePicker x:Name="RepeatUntilPicker" Header="Repeat until (optional)"
                                PlaceholderText="Forever"
                                HorizontalAlignment="Stretch" />
        </StackPanel>
    </StackPanel>
</UserControl>
