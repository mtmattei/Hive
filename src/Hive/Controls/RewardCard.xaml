<UserControl
    x:Class="Hive.Controls.RewardCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Emoji -->
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                    Background="{StaticResource SandBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="EmojiText" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Title + progress -->
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource BodySemiBoldStyle}" />

                <!-- Progress bar -->
                <Grid Height="6" CornerRadius="3">
                    <Border Background="{StaticResource SandBrush}" CornerRadius="3" />
                    <Border x:Name="ProgressFill" Background="{StaticResource OchreBrush}"
                            CornerRadius="3" HorizontalAlignment="Left" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="⭐" FontSize="11" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource SmallLabelStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Redeem button -->
            <Button Grid.Column="2" x:Name="RedeemButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Redeem"
                    Padding="12,6" MinHeight="32" FontSize="12"
                    VerticalAlignment="Center"
                    IsEnabled="False" />
        </Grid>
    </Border>
</UserControl>
