<ContentDialog
    x:Class="Hive.Dialogs.AddEventDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Hive.Controls"
    xmlns:converters="using:Hive.Converters"
    Title="Add Event"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSave">

    <ContentDialog.Resources>
        <converters:HexColorToBrushConverter x:Key="HexToBrush" />
    </ContentDialog.Resources>

    <StackPanel Spacing="16" MinWidth="400">

        <!-- Title -->
        <TextBox x:Name="TitleInput" Header="Title" PlaceholderText="Event title" />

        <!-- All Day toggle -->
        <ToggleSwitch x:Name="AllDayToggle" Header="All Day" Toggled="OnAllDayToggled" />

        <!-- Date -->
        <CalendarDatePicker x:Name="DatePicker" Header="Date"
                            HorizontalAlignment="Stretch" />

        <!-- Time (hidden when All Day) -->
        <Grid x:Name="TimePanel" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TimePicker Grid.Column="0" x:Name="StartTimePicker" Header="Start Time" />
            <TimePicker Grid.Column="1" x:Name="EndTimePicker" Header="End Time" />
        </Grid>

        <!-- Profile assignment -->
        <ComboBox x:Name="ProfileCombo" Header="Profile" HorizontalAlignment="Stretch"
                  DisplayMemberPath="Name" />

        <!-- Location -->
        <TextBox x:Name="LocationInput" Header="Location" PlaceholderText="Optional" />

        <!-- Notes -->
        <TextBox x:Name="NotesInput" Header="Notes" PlaceholderText="Optional"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />

        <!-- Recurrence -->
        <controls:RecurrenceEditor x:Name="RecurrenceControl" />

        <!-- Reminder -->
        <ComboBox x:Name="ReminderCombo" Header="Reminder" SelectedIndex="0"
                  HorizontalAlignment="Stretch">
            <ComboBoxItem Content="None" Tag="0" />
            <ComboBoxItem Content="5 minutes before" Tag="5" />
            <ComboBoxItem Content="15 minutes before" Tag="15" />
            <ComboBoxItem Content="30 minutes before" Tag="30" />
            <ComboBoxItem Content="1 hour before" Tag="60" />
            <ComboBoxItem Content="1 day before" Tag="1440" />
        </ComboBox>

    </StackPanel>
</ContentDialog>
