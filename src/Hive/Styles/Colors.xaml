<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════
         COSTA DESIGN SYSTEM — Color Palette
         Mediterranean Modern: sun-bleached stone, deep azure,
         olive groves, ceramic tile.
         ═══════════════════════════════════════════════════ -->

    <!-- Primary -->
    <Color x:Key="Sea">#1B6B93</Color>
    <Color x:Key="SeaDeep">#134B66</Color>
    <Color x:Key="SeaLight">#E8F4F8</Color>
    <Color x:Key="SeaWash">#F2F9FB</Color>

    <!-- Accent -->
    <Color x:Key="Terra">#C2553A</Color>
    <Color x:Key="TerraLight">#FAEAE6</Color>

    <!-- Semantic -->
    <Color x:Key="Olive">#6A8E4E</Color>
    <Color x:Key="Ochre">#D4923A</Color>
    <Color x:Key="Purple">#7B5EA7</Color>

    <!-- Surfaces -->
    <Color x:Key="Stone">#FAFAF7</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Sand">#F5F3EE</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#1A1A1A</Color>
    <Color x:Key="TextSecondary">#5A5A5A</Color>
    <Color x:Key="TextTertiary">#9A9A9A</Color>

    <!-- Borders -->
    <Color x:Key="Border">#E8E6E1</Color>
    <Color x:Key="BorderLight">#F0EEEA</Color>

    <!-- Profile Colors (default set) -->
    <Color x:Key="ProfileMom">#C2553A</Color>
    <Color x:Key="ProfileDad">#1B6B93</Color>
    <Color x:Key="ProfileEmma">#6A8E4E</Color>
    <Color x:Key="ProfileLucas">#D4923A</Color>
    <Color x:Key="ProfileFamily">#7B5EA7</Color>

    <!-- ═══ Brushes ═══ -->
    <SolidColorBrush x:Key="SeaBrush" Color="{StaticResource Sea}" />
    <SolidColorBrush x:Key="SeaDeepBrush" Color="{StaticResource SeaDeep}" />
    <SolidColorBrush x:Key="SeaLightBrush" Color="{StaticResource SeaLight}" />
    <SolidColorBrush x:Key="SeaWashBrush" Color="{StaticResource SeaWash}" />
    <SolidColorBrush x:Key="TerraBrush" Color="{StaticResource Terra}" />
    <SolidColorBrush x:Key="TerraLightBrush" Color="{StaticResource TerraLight}" />
    <SolidColorBrush x:Key="OliveBrush" Color="{StaticResource Olive}" />
    <SolidColorBrush x:Key="OchreBrush" Color="{StaticResource Ochre}" />
    <SolidColorBrush x:Key="OchreTintBrush" Color="#FFF5E6D0" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource Purple}" />
    <SolidColorBrush x:Key="StoneBrush" Color="{StaticResource Stone}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="SandBrush" Color="{StaticResource Sand}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />

</ResourceDictionary>
