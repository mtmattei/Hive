<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════
         COSTA DESIGN SYSTEM — Typography
         Display: Playfair Display (serif, editorial)
         Body: Source Sans 3 (clean, modern sans-serif)
         ═══════════════════════════════════════════════════ -->

    <FontFamily x:Key="DisplayFont">ms-appx:///Assets/Fonts/PlayfairDisplay-Bold.ttf#Playfair Display</FontFamily>
    <FontFamily x:Key="DisplayFontExtraBold">ms-appx:///Assets/Fonts/PlayfairDisplay-ExtraBold.ttf#Playfair Display</FontFamily>
    <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/SourceSans3-Regular.ttf#Source Sans 3</FontFamily>
    <FontFamily x:Key="BodyFontSemiBold">ms-appx:///Assets/Fonts/SourceSans3-SemiBold.ttf#Source Sans 3</FontFamily>
    <FontFamily x:Key="BodyFontBold">ms-appx:///Assets/Fonts/SourceSans3-Bold.ttf#Source Sans 3</FontFamily>

    <!-- Page Title — 24-32px Playfair Bold -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Large Date — 32px Playfair ExtraBold (schedule view column dates) -->
    <Style x:Key="LargeDateStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontExtraBold}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Section Heading — 16-20px Playfair Bold -->
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Body — 14px Source Sans Regular -->
    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Body Secondary — 14px Source Sans Regular, muted -->
    <Style x:Key="BodySecondaryStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Body SemiBold — 14px Source Sans SemiBold -->
    <Style x:Key="BodySemiBoldStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Small Label — 12px Source Sans SemiBold -->
    <Style x:Key="SmallLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontSemiBold}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Tiny Label — 10px Source Sans Bold, all-caps -->
    <Style x:Key="TinyLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontBold}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- Sidebar Label — 9px Source Sans SemiBold, uppercase -->
    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontSemiBold}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- Event Time — 13px Source Sans Regular, secondary color -->
    <Style x:Key="EventTimeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Day Header — 11px Source Sans Bold, uppercase -->
    <Style x:Key="DayHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontBold}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

</ResourceDictionary>
