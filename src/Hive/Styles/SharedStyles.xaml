<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════
         COSTA DESIGN SYSTEM — Shared Styles
         Card shapes, spacing, buttons, tile accents
         ═══════════════════════════════════════════════════ -->

    <!-- Spacing tokens (4px base) -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceSM">8</x:Double>
    <x:Double x:Key="SpaceMD">12</x:Double>
    <x:Double x:Key="SpaceLG">16</x:Double>
    <x:Double x:Key="SpaceXL">20</x:Double>
    <x:Double x:Key="SpaceXXL">24</x:Double>

    <!-- Corner radii -->
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="GridRadius">14</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">8</CornerRadius>
    <CornerRadius x:Key="ChipRadius">20</CornerRadius>
    <CornerRadius x:Key="SidebarItemRadius">12</CornerRadius>

    <!-- ═══ Card Style ═══ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ═══ Event Card (color bar on left) ═══ -->
    <Style x:Key="EventCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ═══ Primary Button (Terra) ═══ -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TerraBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonRadius}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <!-- ═══ Secondary Button ═══ -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SeaBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonRadius}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <!-- ═══ FAB (Floating Action Button) ═══ -->
    <Style x:Key="FabStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TerraBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ═══ Profile Chip ═══ -->
    <Style x:Key="ProfileChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource ChipRadius}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- ═══ Navigation Item ═══ -->
    <Style x:Key="NavItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SidebarItemRadius}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontSemiBold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ═══ Today Badge (filled circle) ═══ -->
    <Style x:Key="TodayBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SeaBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══ Grid Container ═══ -->
    <Style x:Key="GridContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource GridRadius}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ═══ Month Header Row ═══ -->
    <Style x:Key="MonthHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SeaDeepBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="14,14,0,0" />
    </Style>

    <!-- ═══ Separator ═══ -->
    <Style x:Key="SeparatorStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
