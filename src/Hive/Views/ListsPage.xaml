<Page
    x:Class="Hive.Views.ListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Hive.Converters"
    Background="{StaticResource StoneBrush}">

    <Page.Resources>
        <converters:HexColorToBrushConverter x:Key="HexToBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Header -->
            <RowDefinition Height="Auto" />   <!-- List tabs -->
            <RowDefinition Height="*" />       <!-- List items -->
            <RowDefinition Height="Auto" />   <!-- Add item input -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Lists" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OnToggleCompleted" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6" MinHeight="32">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="12" />
                        <TextBlock x:Name="ToggleLabel" Text="Show Completed" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="OnAddList" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6" MinHeight="32">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="Add List" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- List tabs (horizontal scroll) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" Margin="0,0,0,16">
            <ItemsRepeater x:Name="ListTabsRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnSelectList" Tag="{Binding}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8" MinHeight="36">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- List items -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <ListView x:Name="ItemsListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                      Click="OnToggleItem" Tag="{Binding Id}" MinWidth="0" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}"
                                       Style="{StaticResource BodyStyle}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2" Click="OnDeleteItem" Tag="{Binding Id}"
                                    Background="Transparent" BorderThickness="0" Padding="4"
                                    MinWidth="0" MinHeight="0">
                                <FontIcon Glyph="&#xE74D;" FontSize="12"
                                          Foreground="{StaticResource TextTertiaryBrush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Add item input -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="NewItemInput" Grid.Column="0"
                     PlaceholderText="Enter new item..."
                     KeyDown="OnNewItemKeyDown"
                     CornerRadius="8" />
            <Button Grid.Column="1" Click="OnAddItem" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="8,0,0,0" Padding="16,8">
                <FontIcon Glyph="&#xE73E;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" x:Name="EmptyState" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE8FD;" FontSize="48" Foreground="{StaticResource TextTertiaryBrush}" />
            <TextBlock Text="No lists yet" Style="{StaticResource SectionHeadingStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Create a shopping or to-do list to get started"
                       Style="{StaticResource BodySecondaryStyle}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
