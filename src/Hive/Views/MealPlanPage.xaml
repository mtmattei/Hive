<Page
    x:Class="Hive.Views.MealPlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource StoneBrush}">

    <Grid Padding="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Header -->
            <RowDefinition Height="Auto" />   <!-- Week nav -->
            <RowDefinition Height="*" />       <!-- Meal grid -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Meal Plan" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OnAddRecipe" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6" MinHeight="32">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BA;" FontSize="12" />
                        <TextBlock Text="Recipes" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="OnAddMeal" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6" MinHeight="32">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="Add Meal" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Week navigation -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OnPreviousWeek"
                    Background="Transparent" BorderThickness="0" Padding="8">
                <FontIcon Glyph="&#xE76B;" FontSize="16" />
            </Button>
            <TextBlock Grid.Column="1" x:Name="WeekLabel"
                       Style="{StaticResource SectionHeadingStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="2" Click="OnNextWeek"
                    Background="Transparent" BorderThickness="0" Padding="8">
                <FontIcon Glyph="&#xE76C;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Meal grid (7 day columns x 4 meal rows) -->
        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid x:Name="MealGrid" />
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" x:Name="EmptyState" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE799;" FontSize="48" Foreground="{StaticResource TextTertiaryBrush}" />
            <TextBlock Text="No meals planned this week" Style="{StaticResource SectionHeadingStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Tap 'Add Meal' to plan breakfast, lunch, dinner, or snacks"
                       Style="{StaticResource BodySecondaryStyle}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
