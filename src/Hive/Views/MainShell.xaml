<UserControl
    x:Class="Hive.Views.MainShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Hive.Views">

    <Grid Background="{StaticResource StoneBrush}">
        <Grid.ColumnDefinitions>
            <!-- Sidebar navigation -->
            <ColumnDefinition Width="220" />
            <!-- Content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Sidebar ═══ -->
        <Border Grid.Column="0" Background="{StaticResource SeaDeepBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Logo -->
                    <RowDefinition Height="Auto" />  <!-- Tile accent strip -->
                    <RowDefinition Height="*" />      <!-- Nav items -->
                    <RowDefinition Height="Auto" />  <!-- Settings -->
                </Grid.RowDefinitions>

                <!-- Logo / App Name -->
                <StackPanel Grid.Row="0" Padding="20,24,20,12">
                    <TextBlock
                        Text="Hive"
                        FontFamily="{StaticResource DisplayFont}"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="White" />
                    <TextBlock
                        Text="FAMILY CALENDAR"
                        Style="{StaticResource SidebarLabelStyle}"
                        Foreground="#88FFFFFF"
                        Margin="0,4,0,0" />
                </StackPanel>

                <!-- Tile accent strip (Mediterranean mosaic) -->
                <Grid Grid.Row="1" Height="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SeaBrush}" />
                    <Border Grid.Column="1" Background="{StaticResource TerraBrush}" />
                    <Border Grid.Column="2" Background="{StaticResource OliveBrush}" />
                    <Border Grid.Column="3" Background="{StaticResource OchreBrush}" />
                </Grid>

                <!-- Nav Items -->
                <StackPanel Grid.Row="2" Padding="12,20,12,0" Spacing="4">
                    <Button x:Name="NavCalendar" Click="OnNavClick" Tag="Calendar"
                            Style="{StaticResource NavItemStyle}" Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE787;" FontSize="18" />
                            <TextBlock Text="Calendar" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavTasks" Click="OnNavClick" Tag="Tasks"
                            Style="{StaticResource NavItemStyle}" Foreground="#AAFFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE73A;" FontSize="18" />
                            <TextBlock Text="Tasks" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavRewards" Click="OnNavClick" Tag="Rewards"
                            Style="{StaticResource NavItemStyle}" Foreground="#AAFFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE734;" FontSize="18" />
                            <TextBlock Text="Rewards" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavMeals" Click="OnNavClick" Tag="Meals"
                            Style="{StaticResource NavItemStyle}" Foreground="#AAFFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE799;" FontSize="18" />
                            <TextBlock Text="Meals" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavLists" Click="OnNavClick" Tag="Lists"
                            Style="{StaticResource NavItemStyle}" Foreground="#AAFFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8FD;" FontSize="18" />
                            <TextBlock Text="Lists" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Settings at bottom -->
                <StackPanel Grid.Row="3" Padding="12,0,12,16">
                    <Border Style="{StaticResource SeparatorStyle}" Background="#33FFFFFF" Margin="0,0,0,12" />
                    <Button x:Name="NavSettings" Click="OnNavClick" Tag="Settings"
                            Style="{StaticResource NavItemStyle}" Foreground="#AAFFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="18" />
                            <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Content Area ═══ -->
        <Frame x:Name="ContentFrame" Grid.Column="1" />
    </Grid>

</UserControl>
