<Page
    x:Class="Hive.Views.EventDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Hive.Converters"
    Background="{StaticResource StoneBrush}">

    <Page.Resources>
        <converters:HexColorToBrushConverter x:Key="HexToBrush" />
    </Page.Resources>

    <Grid Padding="24,20" MaxWidth="600" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Back + actions -->
            <RowDefinition Height="*" />    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OnBack" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="8,6" MinHeight="32" MinWidth="32"
                    AutomationProperties.Name="Go back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <TextBlock Grid.Column="1" Text="Event Details"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="16,0,0,0" VerticalAlignment="Center" />

            <Button Grid.Column="2" Click="OnEdit" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6" MinHeight="32" Margin="0,0,8,0"
                    AutomationProperties.Name="Edit event">
                <FontIcon Glyph="&#xE70F;" FontSize="14" />
            </Button>

            <Button Grid.Column="3" Click="OnDelete" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6" MinHeight="32"
                    AutomationProperties.Name="Delete event">
                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource TerraBrush}" />
            </Button>
        </Grid>

        <!-- Event details -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- Profile + title -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProfileAvatar" Width="40" Height="40" CornerRadius="20">
                                <TextBlock x:Name="ProfileInitial" Foreground="White"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="EventTitle" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock x:Name="ProfileName" Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Date & time -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="{StaticResource SeaBrush}" />
                            <TextBlock x:Name="DateText" Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="TimeRow" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{StaticResource SeaBrush}" />
                            <TextBlock x:Name="TimeText" Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Location -->
                <Border x:Name="LocationCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE707;" FontSize="16" Foreground="{StaticResource SeaBrush}" />
                        <TextBlock x:Name="LocationText" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <Border x:Name="NotesCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notes" Style="{StaticResource SmallLabelStyle}" />
                        <TextBlock x:Name="NotesText" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Recurrence -->
                <Border x:Name="RecurrenceCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{StaticResource SeaBrush}" />
                        <TextBlock x:Name="RecurrenceText" Style="{StaticResource BodyStyle}" />
                    </StackPanel>
                </Border>

                <!-- Reminder -->
                <Border x:Name="ReminderCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEA8F;" FontSize="16" Foreground="{StaticResource OchreBrush}" />
                        <TextBlock x:Name="ReminderText" Style="{StaticResource BodyStyle}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
