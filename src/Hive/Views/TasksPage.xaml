<Page
    x:Class="Hive.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Hive.Converters"
    Background="{StaticResource StoneBrush}">

    <Page.Resources>
        <converters:HexColorToBrushConverter x:Key="HexToBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header -->
            <RowDefinition Height="*" />      <!-- Task columns -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Tasks" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="DateLabel" Style="{StaticResource BodySecondaryStyle}" Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Click="OnAddTask" Style="{StaticResource FabStyle}"
                    Width="40" Height="40" CornerRadius="20">
                <FontIcon Glyph="&#xE710;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Task columns per profile (horizontal scroll) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled">
            <ItemsRepeater x:Name="ProfileColumnsRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <!-- Per-profile task column -->
                        <Border Style="{StaticResource CardStyle}" Width="280" VerticalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <!-- Profile header -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                            Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource SmallLabelStyle}">
                                        <Run Text="⭐" /><Run Text="{Binding StarBalance}" />
                                    </TextBlock>
                                </Grid>

                                <Border Style="{StaticResource SeparatorStyle}" />

                                <!-- Tasks will be populated per profile -->
                                <TextBlock Text="No tasks assigned"
                                           Style="{StaticResource BodySecondaryStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,20,0,20" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="1"
                    x:Name="EmptyState"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <FontIcon Glyph="&#xE73A;" FontSize="48" Foreground="{StaticResource TextTertiaryBrush}" />
            <TextBlock Text="No tasks yet" Style="{StaticResource SectionHeadingStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Tap + to create chores and routines"
                       Style="{StaticResource BodySecondaryStyle}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
